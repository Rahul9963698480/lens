APP_NAME=xymp_lens_backend

# Prefer Supabase pooler URI (Settings → Database → Connection string → Session/Transaction pooler)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct db.*.supabase.co:5432 is often IPv6-only and unreachable from Windows.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
