APP_NAME=xymp_lens_backend

# Prefer Supabase pooler URI (Settings → Database → Connection string → Session/Transaction pooler)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct db.*.supabase.co:5432 is often IPv6-only and unreachable from Windows.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Supabase Storage (xlsx project files) — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=xlsx-projects

# Natural-language to SQL agent — POST /projects/{id}/sql/generate and /sql/execute
OPENAI_API_KEY=
MODEL_ID=gpt-4o
RELATIONSHIP_VERIFY_MODEL_ID=gpt-4o-mini

# Apply backend/supabase/migrations including playground_conversations.sql on the same database.

# Excel → DuckDB ingest and query tuning
XLSX_INGEST_CHUNK_SIZE=3000
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4
